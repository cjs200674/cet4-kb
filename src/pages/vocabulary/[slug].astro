---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('vocabulary');
  return entries.map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL;
---

<Layout title={entry.data.word} description={entry.data.description}>
  <p><a href={`${base}vocabulary`}>← 返回词汇列表</a></p>

  <article>
    <header>
      <h1>{entry.data.title || entry.data.word}</h1>
      <div class="card-meta">
        {entry.data.phonetic && <span class="dim">{entry.data.phonetic}</span>}
        {entry.data.pos && <span class="tag">{entry.data.pos}</span>}
        <span class={`tag tag-${entry.data.difficulty}`}>{entry.data.difficulty}</span>
        {entry.data.tags?.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    <Content />
  </article>
</Layout>
