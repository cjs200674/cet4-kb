const quizData = quizByEntry[entry.slug] || null;

// 提取 body 文本用于 TTS（去掉 markdown 标记）
function extractText(markdown: string): string {
  return markdown
    .replace(/^---[\s\S]*?---/, '') // 去掉 frontmatter
    .replace(/```[\s\S]*?```/g, '') // 去掉代码块
    .replace(/^#+\s*/gm, '') // 去掉标题
    .replace(/\*\*([^*]+)\*\*/g, '$1') // 去掉粗体
    .replace(/\*([^*]+)\*/g, '$1') // 去掉斜体
    .replace(/`([^`]+)`/g, '$1') // 去掉行内代码
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') // 去掉链接
    .replace(/^[-*+]\s+/gm, '') // 去掉列表符
    .replace(/\n{2,}/g, '\n') // 合并空行
    .replace(/[<>]/g, '') // 去掉残留
    .trim();
}

// entry.body 不可直接访问，用 Content 不行 — 我们需要 entry 的 markdown 原文
// Astro 5 提供 entry.body 字段吗？用 render() 的 markdown 字段更稳
---

<Layout title={entry.data.title} description={entry.data.description}>
  <p><a href={`${base}listening`}>← 返回听力列表</a></p>
  <article>
    <h1>{entry.data.title}</h1>
    <div class="card-meta">
      {entry.data.year && <span class="tag">{entry.data.year} 年</span>}
      {entry.data.section && <span class="tag">{entry.data.section}</span>}
    </div>

    <Content />
  </article>

  {quizData && (
    <section class="mt-3">
      <Quiz
        questions={quizData.questions}
        title={quizData.title}
        collection={quizData.collection}
        pageSource={quizData.pageSource}
      />
    </section>
  )}

  <script define:vars={{ slug: entry.slug, body: entry.body || '' }}>
    // 拿到 entry 的 markdown body 后动态挂 TTS 按钮
    const articleEl = document.querySelector('article');
    if (articleEl && body) {
      // 提取纯文本（粗略处理）
      const tmp = document.createElement('div');
      tmp.innerHTML = body
        .replace(/```[\s\S]*?```/g, '')
        .replace(/[#*`>]/g, '')
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
        .replace(/^---[\s\S]*?---/, '');
      const text = tmp.textContent || '';
      // 创建一个浮动工具栏
      const toolbar = document.createElement('div');
      toolbar.className = 'speak-toolbar';
      toolbar.innerHTML = `
        <button class="btn speak-all-btn" data-state="idle" style="background: var(--c-accent); color: #000; border-color: var(--c-accent); font-weight: 600;">
          <span class="speak-all-icon">▶</span>
          <span class="speak-all-label">朗读整篇原文</span>
        </button>
        <button class="btn speak-stop-btn" style="display:none;">⏹ 停止</button>
        <span class="speak-hint dim">提示：用浏览器内置语音引擎，建议用 Chrome/Edge</span>
      `;
      articleEl.insertBefore(toolbar, articleEl.firstChild);

      const playBtn = toolbar.querySelector('.speak-all-btn')!;
      const stopBtn = toolbar.querySelector('.speak-stop-btn')!;
      const iconEl = playBtn.querySelector('.speak-all-icon')!;
      const labelEl = playBtn.querySelector('.speak-all-label')!;
      let isPlaying = false;

      function setState(s) {
        if (s === 'playing') {
          playBtn.style.display = 'none';
          stopBtn.style.display = 'inline-block';
        } else {
          playBtn.style.display = 'inline-block';
          stopBtn.style.display = 'none';
        }
      }

      playBtn.addEventListener('click', () => {
        window.speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(text);
        u.rate = 0.9;
        u.lang = 'en-US';
        u.onend = () => { isPlaying = false; setState('idle'); };
        u.onerror = () => { isPlaying = false; setState('idle'); };
        window.speechSynthesis.speak(u);
        isPlaying = true;
        setState('playing');
      });

      stopBtn.addEventListener('click', () => {
        window.speechSynthesis.cancel();
        isPlaying = false;
        setState('idle');
      });
    }
  </script>

  <style>
    .speak-toolbar {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin: 0 0 16px;
      padding: 12px;
      background: var(--c-bg-soft);
      border: 1px solid var(--c-border);
      border-radius: 8px;
    }
    .speak-hint { font-size: 12px; }
  </style>
</Layout>
