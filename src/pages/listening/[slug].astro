---
import Layout from '../../layouts/Layout.astro';
import SpeakButton from '../../components/SpeakButton.astro';
import Quiz from '../../components/Quiz.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const entries = await getCollection('listening');
  return entries.map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");

// 读原始 markdown 拿到 body（Astro 5 entry.body 已废弃）
const rawPath = path.join(process.cwd(), 'src/content/listening', `${entry.slug}.md`);
let rawBody = '';
try { rawBody = fs.readFileSync(rawPath, 'utf-8').replace(/^---[\s\S]*?---/, ''); } catch {}

// 场景词页面：给一个慢速朗读的词表
const isScenes = entry.slug === 'scenes-vocabulary';
const sceneWords = isScenes ? [
  // 图书馆
  { word: 'librarian', phonetic: '/laɪˈbreərɪən/', meaning: '图书管理员' },
  { word: 'renew', phonetic: '/rɪˈnjuː/', meaning: '续借' },
  { word: 'overdue', phonetic: '/ˌəʊvəˈdjuː/', meaning: '逾期的' },
  { word: 'catalog', phonetic: '/ˈkætəlɒɡ/', meaning: '目录' },
  { word: 'check out', phonetic: '/tʃek aʊt/', meaning: '借出' },
  { word: 'return', phonetic: '/rɪˈtɜːn/', meaning: '归还' },
  // 医院
  { word: 'prescription', phonetic: '/prɪˈskrɪpʃn/', meaning: '处方' },
  { word: 'symptom', phonetic: '/ˈsɪmptəm/', meaning: '症状' },
  { word: 'diagnosis', phonetic: '/ˌdaɪəɡˈnəʊsɪs/', meaning: '诊断' },
  { word: 'appointment', phonetic: '/əˈpɔɪntmənt/', meaning: '预约' },
  // 机场
  { word: 'departure', phonetic: '/dɪˈpɑːtʃə/', meaning: '出发' },
  { word: 'arrival', phonetic: '/əˈraɪvl/', meaning: '到达' },
  { word: 'delayed', phonetic: '/dɪˈleɪd/', meaning: '延误的' },
  { word: 'gate', phonetic: '/ɡeɪt/', meaning: '登机口' },
  { word: 'boarding', phonetic: '/ˈbɔːdɪŋ/', meaning: '登机' },
  // 餐厅
  { word: 'menu', phonetic: '/ˈmenjuː/', meaning: '菜单' },
  { word: 'reservation', phonetic: '/ˌrezəˈveɪʃn/', meaning: '预订' },
  { word: 'appetizer', phonetic: '/ˈæpɪtaɪzə/', meaning: '开胃菜' },
  { word: 'check / bill', phonetic: '/tʃek/ /bɪl/', meaning: '账单' },
  { word: 'tip', phonetic: '/tɪp/', meaning: '小费' },
  // 酒店
  { word: 'check in', phonetic: '/tʃek ɪn/', meaning: '入住' },
  { word: 'check out', phonetic: '/tʃek aʊt/', meaning: '退房' },
  { word: 'reservation', phonetic: '/ˌrezəˈveɪʃn/', meaning: '预订' },
  { word: 'reception', phonetic: '/rɪˈsepʃn/', meaning: '前台' },
  { word: 'wake-up call', phonetic: '/ˈweɪk ʌp kɔːl/', meaning: '叫醒电话' },
] : [];

// 听力原文分段（按段落或空行）
// 关键：每段尽量短，让 ±5 秒跳跃更精确
function splitIntoSegments(markdown: string): string[] {
  const text = markdown
    .replace(/```[\s\S]*?```/g, '')
    .replace(/^#+\s*/gm, '')
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/\*([^*]+)\*/g, '$1')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/^\s*[-*+]\s+/gm, '')
    .replace(/[<>]/g, '')
    .trim();

  // 按空行分段；每段再按短句切（句号、问号、感叹号、逗号、冒号、问号）
  // 目标：每段 ≈ 8-15 词，对应 1-2 秒朗读
  const paragraphs = text.split(/\n{2,}/).map(p => p.trim()).filter(p => p.length > 0);
  const segments: string[] = [];
  const splitRe = /(?<=[.!?。！？])\s+|(?<=[,，])\s+/;
  for (const p of paragraphs) {
    if (p.length < 80) {
      segments.push(p);
    } else {
      const sentences = p.split(splitRe).map(s => s.trim()).filter(s => s.length > 0);
      segments.push(...sentences);
    }
  }
  return segments;
}

const segments = splitIntoSegments(rawBody);

// 估算每段朗读时长（秒）。基于：英文 ~14 chars/sec @ rate=1，按 rate 缩放。
// 句末标点（.!?）加 0.4s 停顿；逗号 0.2s。
function estimateDurations(segs: string[], rate: number): number[] {
  const cps = 14 * rate; // chars per second
  return segs.map((s) => {
    let t = s.length / cps;
    if (/[.!?]$/.test(s)) t += 0.4;
    else if (/[,;:]$/.test(s)) t += 0.2;
    return Math.max(0.3, t);
  });
}

// 听力题库
const quizByEntry: Record<string, any> = {
  'scenes-vocabulary': {
    title: '听力场景词测验',
    collection: 'listening',
    pageSource: '听力场景词',
    questions: [
      { id: 'sv-1', question: '"I need to renew my library book" — "renew" 在这个语境下最接近：', options: [{id:'A',text:'归还'},{id:'B',text:'续借'},{id:'C',text:'购买'},{id:'D',text:'借出'}], correct: 'B', explain: 'renew 在图书馆场景中是"续借"，renew 也有"更新、续期"的意思。' },
      { id: 'sv-2', question: '在餐厅场景，顾客对服务员说 "Could I have the check, please?"，意思是：', options: [{id:'A',text:'点菜'},{id:'B',text:'买单'},{id:'C',text:'换桌'},{id:'D',text:'催菜'}], correct: 'B', explain: 'check 在美式英语中是"账单"，英式英语常用 bill。Could I have the check? = 我可以结账吗？' },
      { id: 'sv-3', question: '在机场听到 "Your flight has been delayed" — "delayed" 意思是：', options: [{id:'A',text:'取消'},{id:'B',text:'延误'},{id:'C',text:'提前'},{id:'D',text:'改签'}], correct: 'B', explain: 'delay = 延误。delayed flight = 延误航班。' },
    ],
  },
  'dictation-guide': {
    title: '精听方法测验',
    collection: 'listening',
    pageSource: '听力精听方法',
    questions: [
      { id: 'dg-1', question: '5 步精听法的第一步是：', options: [{id:'A',text:'看原文'},{id:'B',text:'盲听一遍'},{id:'C',text:'跟读'},{id:'D',text:'脱稿复听'}], correct: 'B', explain: '5 步精听法：①盲听 ②听写 ③对照原文 ④跟读 ⑤脱稿复听。' },
      { id: 'dg-2', question: '英语听力中常见的失爆现象是指：', options: [{id:'A',text:'声音消失'},{id:'B',text:'前一个爆破音只做口型不送气'},{id:'C',text:'语音变调'},{id:'D',text:'语速变慢'}], correct: 'B', explain: '失爆：爆破音 + 爆破音时，前一个爆破音只做口型不送气。' },
    ],
  },
  'news-headlines': {
    title: '新闻听力测验',
    collection: 'listening',
    pageSource: '新闻听力',
    questions: [
      { id: 'nh-1', question: '听到 "according to officials" 后面通常跟：', options: [{id:'A',text:'个人观点'},{id:'B',text:'官方说法'},{id:'C',text:'天气情况'},{id:'D',text:'体育比分'}], correct: 'B', explain: 'according to officials = 据官方人士称。' },
      { id: 'nh-2', question: '听到 "magnitude 6.5" 在新闻中通常指：', options: [{id:'A',text:'经济损失 6.5 亿'},{id:'B',text:'地震 6.5 级'},{id:'C',text:'风速 6.5 级'},{id:'D',text:'失业率 6.5%'}], correct: 'B', explain: 'magnitude 专指地震震级。' },
    ],
  },
  '2023-12-section-a': {
    title: '2023-12 长对话 刷题',
    collection: 'listening',
    pageSource: '2023-12 长对话',
    questions: [
      { id: '23-12-sa-1', question: '女学生借了几本书？', options: [{id:'A',text:'一本'},{id:'B',text:'两本'},{id:'C',text:'三本'},{id:'D',text:'四本'}], correct: 'C', explain: '"I\'d like to borrow these three books"。' },
      { id: '23-12-sa-2', question: '新书能借多久？', options: [{id:'A',text:'两天'},{id:'B',text:'一周'},{id:'C',text:'两周'},{id:'D',text:'一个月'}], correct: 'B', explain: '"for new books, only one week"。' },
      { id: '23-12-sa-3', question: '考试期间图书馆开放到几点？', options: [{id:'A',text:'晚上 8 点'},{id:'B',text:'晚上 10 点'},{id:'C',text:'晚上 12 点'},{id:'D',text:'凌晨 2 点'}], correct: 'C', explain: '"We extend our hours to midnight during exams"。' },
      { id: '23-12-sa-4', question: '24 小时自习室在哪层？', options: [{id:'A',text:'一楼'},{id:'B',text:'二楼'},{id:'C',text:'三楼'},{id:'D',text:'四楼'}], correct: 'C', explain: '"a 24-hour study room on the third floor"。' },
      { id: '23-12-sa-5', question: '逾期还书的费用是多少？', options: [{id:'A',text:'每本每天 10 美分'},{id:'B',text:'每本每天 50 美分'},{id:'C',text:'每本每天 1 美元'},{id:'D',text:'免费'}], correct: 'B', explain: '"50 cents per day per book"。' },
    ],
  },
  '2023-06-section-b': {
    title: '2023-06 听力篇章 刷题',
    collection: 'listening',
    pageSource: '2023-06 听力篇章',
    questions: [
      { id: '23-06-sb-1', question: '远程办公最初被看作什么？', options: [{id:'A',text:'永久趋势'},{id:'B',text:'临时措施'},{id:'C',text:'工作福利'},{id:'D',text:'企业文化'}], correct: 'B', explain: '"initially seen as a temporary measure"。' },
      { id: '23-06-sb-2', question: '远程办公的三个优点不包括：', options: [{id:'A',text:'节省通勤时间'},{id:'B',text:'工作生活更平衡'},{id:'C',text:'更高的生产力'},{id:'D',text:'更多团队协作'}], correct: 'D', explain: '优点是 First(节省通勤) Second(工作生活平衡) Third(生产力)。' },
      { id: '23-06-sb-3', question: '远程办公的缺点之一是：', options: [{id:'A',text:'工资低'},{id:'B',text:'网络慢'},{id:'C',text:'孤独感'},{id:'D',text:'工作时间长但压力大'}], correct: 'C', explain: '"Many workers report feelings of isolation"。' },
      { id: '23-06-sb-4', question: '未来办公模式最可能是：', options: [{id:'A',text:'完全远程'},{id:'B',text:'完全回办公室'},{id:'C',text:'混合办公'},{id:'D',text:'自由选择'}], correct: 'C', explain: '"a hybrid model appears to be the most likely future of work"。' },
    ],
  },
  '2022-12-section-c': {
    title: '2022-12 新闻 刷题',
    collection: 'listening',
    pageSource: '2022-12 新闻',
    questions: [
      { id: '22-12-sc-1', question: 'Perseverance 2 计划何时发射？', options: [{id:'A',text:'2022 年'},{id:'B',text:'2025 年'},{id:'C',text:'2027 年'},{id:'D',text:'2030 年'}], correct: 'C', explain: '"scheduled to launch in 2027"。' },
      { id: '22-12-sc-2', question: '火星任务预计耗资多少？', options: [{id:'A',text:'27 亿美元'},{id:'B',text:'2.7 亿美元'},{id:'C',text:'2.7 亿美元'},{id:'D',text:'270 万美元'}], correct: 'A', explain: '"approximately 2.7 billion dollars"。' },
      { id: '22-12-sc-3', question: '气候峰会在哪里召开？', options: [{id:'A',text:'巴黎'},{id:'B',text:'日内瓦'},{id:'C',text:'纽约'},{id:'D',text:'伦敦'}], correct: 'B', explain: '"World leaders gathered in Geneva"。' },
      { id: '22-12-sc-4', question: '关于痴呆症研究，正确的说法是：', options: [{id:'A',text:'运动增加风险'},{id:'B',text:'每天 30 分钟运动可降低 40% 风险'},{id:'C',text:'只对年轻人有效'},{id:'D',text:'研究只持续了 1 年'}], correct: 'B', explain: '"30 minutes a day were 40% less likely"。' },
    ],
  },
};

const quizData = quizByEntry[entry.slug] || null;
---

<Layout title={entry.data.title} description={entry.data.description}>
  <p><a href={`${base}listening`}>← 返回听力列表</a></p>
  <article>
    <h1>{entry.data.title}</h1>
    <div class="card-meta">
      {entry.data.year && <span class="tag">{entry.data.year} 年</span>}
      {entry.data.section && <span class="tag">{entry.data.section}</span>}
    </div>

    <Content />
  </article>

  {isScenes && (
    <section class="scene-speak mt-3">
      <h2>🎧 场景词慢速朗读（语速 0.5）</h2>
      <p class="dim">每个词读 2 遍英文 + 1 遍中文，语速 0.5（更慢）</p>
      <div class="word-speak-host scene-host" data-words={JSON.stringify(sceneWords.map(w => ({ word: w.word, phonetic: w.phonetic, pos: '', meaning: w.meaning })))}></div>
    </section>
  )}

  <section class="tts-section mt-3" data-tts-host>
    <h2>🎙️ 全文朗读（含进度条 + 键盘控制）</h2>
    <div class="tts-toolbar">
      <button class="btn btn-primary lsn-play" data-state="idle">
        <span class="lsn-icon">▶</span>
        <span class="lsn-label">开始朗读全文</span>
      </button>
      <button class="btn lsn-pause" style="display:none;">⏸ 暂停</button>
      <button class="btn lsn-stop" style="display:none;">⏹ 停止</button>
      <span class="rate-display dim">语速: <span class="lsn-rate">0.7</span>x</span>
      <button class="btn lsn-rate-down">−</button>
      <button class="btn lsn-rate-up">+</button>
    </div>
    <div class="tts-progress mt-2">
      <div class="tts-progress-meta">
        <span class="lsn-current-word">准备开始</span>
        <span class="lsn-counter dim">
          <span class="lsn-time">0:00 / 0:00</span>
          · <span class="lsn-current">0</span> / <span class="lsn-total">{segments.length}</span> 段
        </span>
      </div>
      <input
        type="range"
        class="lsn-slider"
        min="0"
        max={Math.max(0, segments.length - 1)}
        value="0"
        step="1"
        aria-label="听力进度条"
      />
      <div class="tts-progress-text dim">点击 ▶ 开始 · 或用键盘：空格/←/→/Esc/↑/↓</div>
    </div>
    <ol class="tts-segments mt-2">
      {segments.map((s, i) => (
        <li class="tts-segment" data-idx={i}>
          <span class="tts-num">{i + 1}</span>
          <span class="tts-text">{s}</span>
          <button class="tts-seg-jump" data-idx={i} title="跳到这一段">▶</button>
        </li>
      ))}
    </ol>
  </section>

  {quizData && (
    <section class="mt-3">
      <Quiz
        questions={quizData.questions}
        title={quizData.title}
        collection={quizData.collection}
        pageSource={quizData.pageSource}
      />
    </section>
  )}

  <script>
    // 全文朗读控制
    (() => {
      const segs: string[] = JSON.parse(document.querySelector('.tts-section')?.dataset.segments || '[]');
      const segsFromDom = Array.from(document.querySelectorAll('.tts-segment .tts-text')).map(e => (e as HTMLElement).textContent || '');
      const list = segsFromDom.length ? segsFromDom : segs;
      if (!list.length) return;

      const playBtn = document.querySelector('.lsn-play') as HTMLButtonElement;
      const pauseBtn = document.querySelector('.lsn-pause') as HTMLButtonElement;
      const stopBtn = document.querySelector('.lsn-stop') as HTMLButtonElement;
      const rateUp = document.querySelector('.lsn-rate-up') as HTMLButtonElement;
      const rateDown = document.querySelector('.lsn-rate-down') as HTMLButtonElement;
      const iconEl = document.querySelector('.lsn-icon') as HTMLElement;
      const labelEl = document.querySelector('.lsn-label') as HTMLElement;
      const slider = document.querySelector('.lsn-slider') as HTMLInputElement;
      const rateEl = document.querySelector('.lsn-rate') as HTMLElement;
      const currentEl = document.querySelector('.lsn-current') as HTMLElement;
      const currentWordEl = document.querySelector('.lsn-current-word') as HTMLElement;
      const segItems = document.querySelectorAll('.tts-segment');

      let idx = 0;
      let isPlaying = false;
      let isPaused = false;
      let pendingResolve: (() => void) | null = null;
      let rate = 0.7;
      let muted = false;

      function setUi(state: 'idle' | 'playing' | 'paused') {
        if (state === 'playing') {
          playBtn.style.display = 'none';
          pauseBtn.style.display = 'inline-block';
          stopBtn.style.display = 'inline-block';
          pauseBtn.textContent = '⏸ 暂停';
          labelEl.textContent = '朗读中…';
        } else if (state === 'paused') {
          playBtn.style.display = 'none';
          pauseBtn.style.display = 'inline-block';
          stopBtn.style.display = 'inline-block';
          pauseBtn.textContent = '▶ 继续';
          labelEl.textContent = '已暂停';
        } else {
          playBtn.style.display = 'inline-block';
          pauseBtn.style.display = 'none';
          stopBtn.style.display = 'none';
          labelEl.textContent = '开始朗读全文';
          iconEl.textContent = '▶';
        }
      }

      function updateDisplay() {
        currentEl.textContent = String(idx);
        const preview = list[idx] || '';
        currentWordEl.textContent = preview.length > 40 ? preview.slice(0, 40) + '…' : preview;
        if (document.activeElement !== slider) slider.value = String(Math.min(idx, list.length - 1));
        segItems.forEach((it, i) => {
          it.classList.remove('tts-current');
          if (i === idx) it.classList.add('tts-current');
          if (i < idx) it.classList.add('tts-done');
        });
        // 滚动到可视
        const cur = segItems[idx];
        if (cur) cur.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      function fullStop() {
        window.speechSynthesis.cancel();
        if (pendingResolve) { pendingResolve(); pendingResolve = null; }
        isPlaying = false;
        isPaused = false;
        idx = 0;
        setUi('idle');
        updateDisplay();
      }

      function pause() {
        window.speechSynthesis.cancel();
        if (pendingResolve) { pendingResolve(); pendingResolve = null; }
        isPlaying = false;
        isPaused = true;
        setUi('paused');
      }

      function speak(text: string, lang: 'en-US' | 'zh-CN'): Promise<void> {
        return new Promise((resolve) => {
          if (!isPlaying) { resolve(); return; }
          const u = new SpeechSynthesisUtterance(text);
          u.lang = lang;
          u.rate = rate;
          u.volume = muted ? 0 : 1;
          u.onend = () => resolve();
          u.onerror = () => resolve();
          pendingResolve = resolve;
          try { window.speechSynthesis.speak(u); } catch { pendingResolve = null; resolve(); }
        });
      }

      function isEnglish(s: string): boolean {
        // 含中文标点或汉字就判为中文
        return !/[\u4e00-\u9fa5\u3000-\u303f\uff00-\uffef]/.test(s);
      }

      async function run() {
        isPlaying = true;
        isPaused = false;
        setUi('playing');
        while (idx < list.length && isPlaying) {
          updateDisplay();
          const seg = list[idx];
          await speak(seg, isEnglish(seg) ? 'en-US' : 'zh-CN');
          if (!isPlaying) return;
          await new Promise(r => setTimeout(r, 300));
          idx++;
        }
        if (isPlaying) {
          currentWordEl.textContent = '🎉 全文朗读完成！';
          currentWordEl.style.color = 'var(--c-accent-2)';
        }
        isPlaying = false;
        isPaused = false;
        setUi('idle');
      }

      function jumpTo(newIdx: number) {
        newIdx = Math.max(0, Math.min(list.length - 1, newIdx));
        if (newIdx === idx && isPlaying) return;
        const wasPlaying = isPlaying;
        window.speechSynthesis.cancel();
        if (pendingResolve) { pendingResolve(); pendingResolve = null; }
        idx = newIdx;
        segItems.forEach((it, i) => {
          if (i < newIdx) it.classList.add('tts-done');
          else it.classList.remove('tts-done');
        });
        updateDisplay();
        if (wasPlaying || isPaused) {
          isPlaying = true;
          isPaused = false;
          setUi('playing');
          run();
        }
      }

      playBtn.addEventListener('click', () => {
        if (!('speechSynthesis' in window)) {
          alert('当前浏览器不支持 speechSynthesis API');
          return;
        }
        idx = 0;
        segItems.forEach((it) => it.classList.remove('tts-done', 'tts-current'));
        run();
      });
      pauseBtn.addEventListener('click', () => {
        if (isPaused) { isPaused = false; isPlaying = true; setUi('playing'); run(); }
        else { pause(); }
      });
      stopBtn.addEventListener('click', fullStop);
      rateUp.addEventListener('click', () => { rate = Math.min(2.0, +(rate + 0.1).toFixed(1)); rateEl.textContent = rate.toFixed(1); });
      rateDown.addEventListener('click', () => { rate = Math.max(0.3, +(rate - 0.1).toFixed(1)); rateEl.textContent = rate.toFixed(1); });

      // Slider
      let dragging = false;
      slider.addEventListener('mousedown', () => { dragging = true; });
      slider.addEventListener('touchstart', () => { dragging = true; });
      slider.addEventListener('mouseup', () => { dragging = false; jumpTo(parseInt(slider.value)); });
      slider.addEventListener('touchend', () => { dragging = false; jumpTo(parseInt(slider.value)); });
      slider.addEventListener('input', () => { if (dragging) { idx = parseInt(slider.value); updateDisplay(); } });

      // 段落跳转按钮
      document.querySelectorAll<HTMLButtonElement>('.tts-seg-jump').forEach((b) => {
        b.addEventListener('click', () => { jumpTo(parseInt(b.dataset.idx!)); });
      });

      // 全局快捷键
      window.addEventListener('tts-toggle', () => {
        if (isPaused) { isPaused = false; isPlaying = true; setUi('playing'); run(); }
        else if (isPlaying) { pause(); }
        else { playBtn.click(); }
      });
      window.addEventListener('tts-stop', () => fullStop());

      // 估算每段时长 + 当前段已朗读秒数
      const durations = estimateDurations(list, rate);
      let elapsedInSeg = 0;     // 当前段已经朗读的秒数
      let segStartTime = 0;     // 当前段开始播放时间戳
      // 实时更新 elapsedInSeg
      setInterval(() => {
        if (isPlaying && segStartTime) {
          elapsedInSeg = (Date.now() - segStartTime) / 1000;
          updateTimeDisplay();
        }
      }, 200);

      function cumulativeTime(targetIdx: number, inSegOffset: number): number {
        let t = 0;
        for (let i = 0; i < Math.min(targetIdx, durations.length); i++) t += durations[i];
        return t + inSegOffset;
      }
      function findIdxAtTime(targetTime: number): number {
        let acc = 0;
        for (let i = 0; i < durations.length; i++) {
          acc += durations[i];
          if (acc >= targetTime) return i;
        }
        return durations.length - 1;
      }
      function skipBy(deltaSec: number) {
        const cur = cumulativeTime(idx, elapsedInSeg);
        const target = Math.max(0, Math.min(totalDurations(), cur + deltaSec));
        const targetIdx = findIdxAtTime(target);
        if (targetIdx === idx && Math.abs(deltaSec) < 1) return;
        jumpTo(targetIdx);
        elapsedInSeg = 0;
        segStartTime = Date.now();
      }
      function totalDurations(): number {
        let s = 0;
        for (const d of durations) s += d;
        return s;
      }
      // 跳到任意段（含 ±5 秒跳跃后的段）
      const origJumpTo = jumpTo;
      jumpTo = function(newIdx: number) {
        origJumpTo(newIdx);
        elapsedInSeg = 0;
        segStartTime = Date.now();
        updateTimeDisplay();
      };

      function updateTimeDisplay() {
        const cur = cumulativeTime(idx, elapsedInSeg);
        const total = totalDurations();
        const fmt = (s: number) => {
          const m = Math.floor(s / 60);
          const ss = Math.floor(s % 60);
          return `${m}:${ss.toString().padStart(2, '0')}`;
        };
        const timeEl = document.getElementById('lsn-time');
        if (timeEl) timeEl.textContent = `${fmt(cur)} / ${fmt(total)}`;
      }

      // 替换 prev/next 为 ±5 秒跳跃
      window.addEventListener('tts-prev', () => {
        if (idx <= 0 && elapsedInSeg < 1) return;
        skipBy(-5);
        if (isPaused) updateDisplay();
      });
      window.addEventListener('tts-next', () => {
        if (idx >= list.length - 1 && elapsedInSeg >= durations[idx] - 1) return;
        skipBy(+5);
        if (isPaused) updateDisplay();
      });

      // 在播放开始时设 segStartTime
      const origRun = run;
      run = async function() {
        segStartTime = Date.now();
        elapsedInSeg = 0;
        await origRun();
      };

      window.addEventListener('tts-rate-up', () => {
        rateUp.click();
        // 语速变化后重算 durations
        for (let i = 0; i < durations.length; i++) {
          durations[i] = estimateDurations([list[i]], rate)[0];
        }
      });
      window.addEventListener('tts-rate-down', () => {
        rateDown.click();
        for (let i = 0; i < durations.length; i++) {
          durations[i] = estimateDurations([list[i]], rate)[0];
        }
      });
      window.addEventListener('tts-mute', () => {
        muted = !muted;
        rateEl.parentElement!.innerHTML = muted ? '🔇 已静音 · 语速: <span class="lsn-rate">' + rate.toFixed(1) + '</span>x' : '语速: <span class="lsn-rate">' + rate.toFixed(1) + '</span>x';
        if (muted && isPlaying) window.speechSynthesis.cancel();
      });

      updateDisplay();
      updateTimeDisplay();
    })();

    // WordSpeak 初始化（场景词朗读）
    (() => {
      const host = document.querySelector('.scene-host') as HTMLElement | null;
      if (!host) return;
      const words: any[] = JSON.parse(host.dataset.words || '[]');
      if (!words.length) return;
      // 简单的场景词朗读
      const playBtn = document.createElement('button');
      playBtn.className = 'btn btn-primary scene-play';
      playBtn.innerHTML = '<span>▶</span> 朗读全部场景词（语速 0.5）';
      const stopBtn = document.createElement('button');
      stopBtn.className = 'btn scene-stop';
      stopBtn.textContent = '⏹ 停止';
      stopBtn.style.display = 'none';
      const hint = document.createElement('span');
      hint.className = 'speak-hint dim';
      hint.textContent = '语速 0.5（更慢）';
      const toolbar = document.createElement('div');
      toolbar.className = 'speak-toolbar';
      toolbar.appendChild(playBtn);
      toolbar.appendChild(stopBtn);
      toolbar.appendChild(hint);
      host.insertBefore(toolbar, host.firstChild);

      const list = document.createElement('ol');
      list.className = 'ws-list mt-2';
      list.innerHTML = words.map((w: any, i: number) => `
        <li class="ws-item" data-idx="${i}">
          <span class="ws-num">${i + 1}</span>
          <span class="ws-word">${w.word}</span>
          <span class="ws-phonetic dim">${w.phonetic}</span>
          <span class="ws-meaning">${w.meaning}</span>
          <span class="ws-status">—</span>
        </li>
      `).join('');
      host.appendChild(list);

      let idx = 0;
      let isPlaying = false;
      let pendingResolve: (() => void) | null = null;
      const items = list.querySelectorAll('.ws-item');

      function setUi(s: 'playing' | 'idle') {
        if (s === 'playing') { playBtn.style.display = 'none'; stopBtn.style.display = 'inline-block'; }
        else { playBtn.style.display = 'inline-block'; stopBtn.style.display = 'none'; }
      }
      function speak(text: string, lang: 'en-US' | 'zh-CN') {
        return new Promise<void>(resolve => {
          if (!isPlaying) { resolve(); return; }
          const u = new SpeechSynthesisUtterance(text);
          u.lang = lang; u.rate = 0.5;
          u.onend = () => resolve();
          u.onerror = () => resolve();
          pendingResolve = resolve;
          try { window.speechSynthesis.speak(u); } catch { pendingResolve = null; resolve(); }
        });
      }
      async function run() {
        isPlaying = true; setUi('playing');
        while (idx < words.length && isPlaying) {
          const w = words[idx];
          items.forEach((it, i) => { it.classList.remove('ws-active'); if (i < idx) it.classList.add('ws-done'); });
          const it = items[idx];
          if (it) { it.classList.add('ws-active'); it.scrollIntoView({behavior:'smooth',block:'nearest'}); }
          const st = it?.querySelector('.ws-status');
          if (st) st.textContent = '英1…';
          await speak(w.word, 'en-US'); if (!isPlaying) return;
          await new Promise(r => setTimeout(r, 500));
          if (st) st.textContent = '英2…';
          await speak(w.word, 'en-US'); if (!isPlaying) return;
          await new Promise(r => setTimeout(r, 700));
          if (st) st.textContent = '中…';
          await speak(w.meaning, 'zh-CN'); if (!isPlaying) return;
          if (st) st.textContent = '✓';
          await new Promise(r => setTimeout(r, 1500));
          idx++;
        }
        isPlaying = false; setUi('idle');
      }
      function stop() { window.speechSynthesis.cancel(); if (pendingResolve) { pendingResolve(); pendingResolve = null; } isPlaying = false; idx = 0; items.forEach(it => it.classList.remove('ws-active','ws-done')); setUi('idle'); }
      playBtn.addEventListener('click', () => { idx = 0; run(); });
      stopBtn.addEventListener('click', stop);
    })();
  </script>

  <style>
    .tts-section {
      background: var(--c-bg-soft);
      border: 1px solid var(--c-border);
      border-radius: 10px;
      padding: 18px;
      margin: 20px 0;
    }
    .tts-toolbar {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .rate-display { font-size: 13px; }
    .tts-progress-meta {
      display: flex;
      justify-content: space-between;
      margin-bottom: 6px;
      font-size: 13px;
    }
    .lsn-current-word { font-weight: 600; color: var(--c-accent); }
    .lsn-counter { font-family: var(--font-mono); }
    .lsn-slider {
      width: 100%;
      height: 8px;
      appearance: none;
      -webkit-appearance: none;
      background: var(--c-bg-soft-2);
      border-radius: 4px;
      outline: none;
      cursor: pointer;
      margin: 6px 0;
    }
    .lsn-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 18px; height: 18px;
      border-radius: 50%;
      background: var(--c-accent);
      border: 2px solid var(--c-bg);
      cursor: grab;
    }
    .lsn-slider::-webkit-slider-thumb:active {
      background: var(--c-accent-2);
      transform: scale(1.2);
    }
    .lsn-slider::-moz-range-thumb {
      width: 18px; height: 18px;
      border-radius: 50%;
      background: var(--c-accent);
      border: 2px solid var(--c-bg);
      cursor: grab;
    }
    .tts-segments {
      list-style: none;
      padding: 0;
      margin: 0;
      max-height: 500px;
      overflow-y: auto;
    }
    .tts-segment {
      display: grid;
      grid-template-columns: 30px 1fr 32px;
      gap: 10px;
      align-items: start;
      padding: 8px;
      border-bottom: 1px solid var(--c-border);
      font-size: 14px;
      line-height: 1.5;
    }
    .tts-segment:hover { background: var(--c-bg-soft-2); }
    .tts-segment.tts-current {
      background: rgba(88, 166, 255, 0.15);
      box-shadow: inset 3px 0 0 var(--c-accent);
    }
    .tts-segment.tts-done .tts-text { color: var(--c-text-soft); }
    .tts-num { color: var(--c-text-dim); font-family: var(--font-mono); }
    .tts-seg-jump {
      background: transparent;
      border: 1px solid var(--c-border);
      color: var(--c-accent);
      width: 28px; height: 28px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 12px;
    }
    .tts-seg-jump:hover { background: var(--c-accent); color: #0d1117; }
    .scene-speak {
      background: rgba(126, 231, 135, 0.05);
      border: 1px solid var(--c-accent-2);
      border-radius: 10px;
      padding: 16px;
    }
    .scene-host {
      background: transparent;
      border: none;
      padding: 0;
      margin: 0;
    }
    .scene-host .ws-list { max-height: 500px; }
  </style>
</Layout>
