---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('exams');
  return entries.map((e) => ({
    params: { slug: e.slug },
    props: { entry: e },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
---

<Layout title={entry.data.title} description={entry.data.description}>
  <p><a href={`${base}exams`}>← 返回真题列表</a></p>

  <article class="exam-article">
    <header>
      <h1>{entry.data.title}</h1>
      <div class="card-meta">
        <span class="tag">{entry.data.year}.{String(entry.data.month).padStart(2, '0')}</span>
        <span class="tag">第 {entry.data.part} 部分</span>
        <span class="tag tag-medium">真题</span>
        {entry.data.source && <span class="dim">来源：{entry.data.source}</span>}
      </div>
    </header>

    <Content />
  </article>
</Layout>

<style is:global>
  .exam-article {
    background: var(--c-bg-soft);
    border: 1px solid var(--c-border);
    border-radius: 10px;
    padding: 24px;
  }
  .exam-article table {
    width: auto;
    border-collapse: collapse;
    margin: 1em 0;
  }
  .exam-article table th,
  .exam-article table td {
    border: 1px solid var(--c-border);
    padding: 4px 8px;
  }
  .exam-article u {
    text-decoration: underline wavy var(--c-accent);
  }
  .exam-article em {
    color: var(--c-text-soft);
  }
</style>
