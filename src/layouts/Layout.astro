---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = '大学英语四级（CET-4）备考知识库' } = Astro.props;
const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | CET-4 备考知识库</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href={base} class="brand">
          <span class="brand-icon">📚</span>
          <span class="brand-text">CET-4 备考</span>
        </a>
        <nav class="site-nav">
          <a href={`${base}vocabulary`}>词汇</a>
          <a href={`${base}reading`}>阅读</a>
          <a href={`${base}listening`}>听力</a>
          <a href={`${base}grammar`}>语法</a>
          <a href={`${base}writing`}>写作</a>
          <a href={`${base}exams`}>真题</a>
          <a href={`${base}mistakes`} class="nav-mistakes">📕 错题 <span id="nav-mistake-count" class="nav-badge hidden">0</span></a>
          <a href={`${base}progress`} class="nav-progress">📊 进度</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>CET-4 KB · Powered by Astro + GitHub Pages · <a href="https://github.com/chu/cet4-kb">源码</a></p>
      </div>
    </footer>

    <style is:global>
      @import '../styles/global.css';

      .nav-mistakes { color: var(--c-error) !important; }
      .nav-badge {
        display: inline-block;
        background: var(--c-error);
        color: #fff;
        font-size: 11px;
        padding: 1px 6px;
        border-radius: 10px;
        margin-left: 4px;
        font-weight: 700;
      }
    </style>

    <script>
      // 错题本数量角标
      function updateMistakeBadge() {
        try {
          const m = JSON.parse(localStorage.getItem('cet4-mistakes') || '{}');
          const count = Object.keys(m).length;
          const badge = document.getElementById('nav-mistake-count');
          if (badge) {
            badge.textContent = String(count);
            badge.classList.toggle('hidden', count === 0);
          }
        } catch {}
      }
      updateMistakeBadge();
      window.addEventListener('cet4-mistakes-update', updateMistakeBadge);

      // ============================================
      // callout 自动包裹（delight + 1）
      // 在阅读/听力详情页，把"考点分析/长难句/记忆法..."等 h2/h3
      // 自动用对应颜色的 callout 包起来
      // ============================================
      (() => {
        const article = document.querySelector('article');
        if (!article) return;
        const keywordMap: [RegExp, string][] = [
          [/考点|长难句|真题示例|应试点拨/i, 'callout-violet'],
          [/记忆法|辨析|易错|注意|应试技巧|辨音|陷阱|易混淆/i, 'callout-amber'],
          [/新闻听力|5\s*步|方法|步骤|关键表达|场景|长对话|精听|dictation/i, 'callout-cyan'],
          [/配套刷题|原文|解析|答案/i, 'callout-success'],
          [/警告|注意|必看|避坑/i, 'callout-warning'],
        ];
        const headings = article.querySelectorAll('h2, h3');
        for (const h of Array.from(headings)) {
          const text = h.textContent || '';
          for (const [re, cls] of keywordMap) {
            if (re.test(text)) {
              wrapSection(h, cls);
              break;
            }
          }
        }
        function wrapSection(h: Element, cls: string) {
          // 找下一个同级或更深级的元素，包到 callout 里
          // 重要：先把所有要移的节点收集到 fragment，
          //       然后再把 wrapper 插入到 h 原位置。
          //       避免 h 被移走后再去查 h.parentNode（那会是 fragment）。
          const parent = h.parentNode!;
          const nextSibling: Element | null = h.nextElementSibling;
          const wrapper = document.createElement('div');
          wrapper.className = 'callout-auto ' + cls;
          parent.insertBefore(wrapper, h);
          // 把 h 自己搬进 wrapper
          wrapper.appendChild(h);
          // 紧随其后的同级元素（到下一个 h1/h2 为止）也搬进去
          let n: Element | null = h.nextElementSibling;
          while (n) {
            const next: Element | null = n.nextElementSibling;
            if (next && (next.tagName === 'H1' || next.tagName === 'H2')) break;
            wrapper.appendChild(n);
            if (!next) break;
            n = next;
          }
        }
      })();

      // ============================================
      // 滚动淡入（delight）
      // ============================================
      (() => {
        if (!('IntersectionObserver' in window)) return;
        const cards = document.querySelectorAll('.card-grid > *');
        cards.forEach((c) => c.classList.add('reveal'));
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.1 }
        );
        cards.forEach((c) => obs.observe(c));
      })();

      // ============================================
      // 阅读进度条（delight）
      // ============================================
      (() => {
        const article = document.querySelector('article');
        if (!article) return;
        const bar = document.createElement('div');
        bar.className = 'reading-progress';
        document.body.appendChild(bar);
        const update = () => {
          const rect = article.getBoundingClientRect();
          const total = rect.height;
          const seen = Math.min(Math.max(-rect.top, 0), total);
          const pct = total > 0 ? (seen / total) * 100 : 0;
          bar.style.width = Math.min(pct, 100) + '%';
        };
        window.addEventListener('scroll', update, { passive: true });
        update();
      })();

      // ============================================
      // 全局键盘快捷键（TTS 通用）
      // 任何带 TTS 的页面监听这些自定义事件即可
      // ============================================
      function hasTTS() {
        return !!document.querySelector(
          '[data-tts-host], .speak-btn, .word-speak-host, .single-speak, .ws-host, .tts-section, .scene-host, .lsn-play'
        );
      }
      document.addEventListener('keydown', (e) => {
        // 输入框里不触发
        const t = e.target as HTMLElement;
        if (t && (t.matches('input, textarea, [contenteditable="true"]') || t.closest('input, textarea, [contenteditable="true"]'))) {
          return;
        }
        if (!hasTTS()) return;
        // Alt 修饰键不冲突
        if (e.altKey) return;

        // Ctrl/Meta 修饰键：给用户"单手大跨度"控制
        // - Ctrl + →/←：前进/后退（用户特别要求）
        // - Ctrl + Space：切换播放/暂停
        if (e.ctrlKey || e.metaKey) {
          if (e.key === 'ArrowRight') { e.preventDefault(); window.dispatchEvent(new CustomEvent('tts-next')); return; }
          if (e.key === 'ArrowLeft')  { e.preventDefault(); window.dispatchEvent(new CustomEvent('tts-prev')); return; }
          if (e.key === ' ')          { e.preventDefault(); window.dispatchEvent(new CustomEvent('tts-toggle')); return; }
          if (e.key === 'ArrowUp')    { e.preventDefault(); window.dispatchEvent(new CustomEvent('tts-rate-up')); return; }
          if (e.key === 'ArrowDown')  { e.preventDefault(); window.dispatchEvent(new CustomEvent('tts-rate-down')); return; }
          if (e.key === 'm' || e.key === 'M') { e.preventDefault(); window.dispatchEvent(new CustomEvent('tts-mute')); return; }
          return;
        }

        // 无修饰键：基础控制
        let evt = '';
        switch (e.key) {
          case ' ':
            evt = 'tts-toggle';
            break;
          case 'ArrowLeft':
            evt = 'tts-prev';
            break;
          case 'ArrowRight':
            evt = 'tts-next';
            break;
          case 'Escape':
            evt = 'tts-stop';
            break;
          case 'ArrowUp':
            evt = 'tts-rate-up';
            break;
          case 'ArrowDown':
            evt = 'tts-rate-down';
            break;
          case 'm':
          case 'M':
            evt = 'tts-mute';
            break;
        }
        if (evt) {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent(evt));
        }
      });

      // 页面底部显示快捷键提示
      window.addEventListener('load', () => {
        if (document.querySelector('[data-tts-host], .speak-btn, .word-speak-host, .single-speak, .ws-host, .tts-section')) {
          let tip = document.getElementById('tts-keys-tip');
          if (!tip) {
            tip = document.createElement('div');
            tip.id = 'tts-keys-tip';
            tip.innerHTML =
              '<strong>⌨️ TTS 快捷键</strong><br>' +
              '<kbd>Space</kbd> 播放/暂停 · <kbd>←</kbd> <kbd>→</kbd> 切段 · <kbd>↑</kbd> <kbd>↓</kbd> 调速<br>' +
              '<kbd>M</kbd> 静音 · <kbd>Esc</kbd> 停止';
            document.body.appendChild(tip);
            // 5 秒后自动淡出
            setTimeout(() => { tip.style.opacity = '0.25'; }, 5000);
            tip.addEventListener('mouseenter', () => { tip.style.opacity = '1'; });
            tip.addEventListener('mouseleave', () => { tip.style.opacity = '0.25'; });
          }
        }
      });
    </script>
  </body>
</html>
