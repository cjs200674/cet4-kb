---
// 进度仪表盘 — 客户端从 localStorage 读取并渲染
---

<div class="dashboard" id="progress-dashboard">
  <div class="dash-card">
    <div class="dash-card-title">已复习卡片</div>
    <div class="dash-card-value" data-stat="reviewed">0</div>
    <div class="dash-card-sub">所有模块合计</div>
  </div>
  <div class="dash-card">
    <div class="dash-card-title">到期复习</div>
    <div class="dash-card-value" data-stat="due" style="color: var(--c-warning);">0</div>
    <div class="dash-card-sub">需要今天复习</div>
  </div>
  <div class="dash-card">
    <div class="dash-card-title">累计答题</div>
    <div class="dash-card-value" data-stat="quiz-total" style="color: var(--c-accent-2);">0</div>
    <div class="dash-card-sub" data-stat="quiz-acc">正确率 --</div>
  </div>
  <div class="dash-card">
    <div class="dash-card-title">连续学习</div>
    <div class="dash-card-value" data-stat="streak" style="color: var(--c-error);">0</div>
    <div class="dash-card-sub">天 🔥</div>
  </div>
</div>

<div class="dash-detail mt-2" id="dash-by-module"></div>

<style>
  .dash-detail {
    background: var(--c-bg-soft);
    border: 1px solid var(--c-border);
    border-radius: 10px;
    padding: 20px;
  }
  .dash-detail h3 { margin-top: 0; }
  .dash-row {
    display: grid;
    grid-template-columns: 80px 1fr 60px;
    gap: 12px;
    align-items: center;
    padding: 8px 0;
  }
  .dash-row + .dash-row {
    border-top: 1px solid var(--c-border);
  }
  .dash-row-name {
    font-weight: 600;
    color: var(--c-text);
  }
  .dash-row-bar {
    background: var(--c-bg-soft-2);
    height: 8px;
    border-radius: 4px;
    overflow: hidden;
  }
  .dash-row-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--c-accent), var(--c-accent-2));
    transition: width 0.4s;
  }
  .dash-row-num {
    text-align: right;
    color: var(--c-text-soft);
    font-size: 13px;
  }
</style>

<script>
  function updateDashboard() {
    const STORAGE_KEY = 'cet4-progress';
    const QUIZ_KEY = 'cet4-quiz-stats';
    const STREAK_KEY = 'cet4-streak';
    const MODULES = ['vocabulary', 'reading', 'listening', 'grammar', 'writing'];

    let storage: Record<string, any> = {};
    let quizStats = { total: 0, correct: 0 };
    try { storage = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch {}
    try { quizStats = JSON.parse(localStorage.getItem(QUIZ_KEY) || '{}'); } catch {}

    const all = Object.entries(storage);
    const reviewed = all.filter(([, p]) => p.reps > 0).length;
    const now = Date.now();
    const due = all.filter(([, p]) => p.reps > 0 && p.due <= now).length;

    // streak
    const today = new Date().toDateString();
    let streak: any = { lastDay: null, count: 0 };
    try { streak = JSON.parse(localStorage.getItem(STREAK_KEY) || '{}'); } catch {}
    if (streak.lastDay !== today) {
      const yest = new Date(Date.now() - 86400000).toDateString();
      if (streak.lastDay === yest || streak.lastDay === null) {
        // 保持或重置
      } else {
        streak.count = 0;
      }
      if (reviewed > 0) {
        if (streak.lastDay === yest) streak.count += 1;
        else if (streak.lastDay !== today) streak.count = 1;
        streak.lastDay = today;
        localStorage.setItem(STREAK_KEY, JSON.stringify(streak));
      }
    }

    const setStat = (name: string, val: any) => {
      document.querySelectorAll(`[data-stat="${name}"]`).forEach((el) => {
        el.textContent = String(val);
      });
    };
    setStat('reviewed', reviewed);
    setStat('due', due);
    setStat('quiz-total', quizStats.total || 0);
    const acc = quizStats.total ? Math.round((quizStats.correct / quizStats.total) * 100) : 0;
    setStat('quiz-acc', `正确率 ${quizStats.total ? acc + '%' : '--'}`);
    setStat('streak', streak.count || 0);

    // 按模块统计
    const detail = document.getElementById('dash-by-module')!;
    detail.innerHTML = '<h3>各模块复习进度</h3>';
    const moduleMax = 50; // 显示百分比的分母
    MODULES.forEach((m) => {
      const moduleCards = all.filter(([k]) => k.startsWith(`${m}::`));
      const moduleReviewed = moduleCards.filter(([, p]) => p.reps > 0).length;
      const pct = Math.min(100, Math.round((moduleReviewed / moduleMax) * 100));
      const row = document.createElement('div');
      row.className = 'dash-row';
      row.innerHTML = `
        <div class="dash-row-name">${moduleLabel(m)}</div>
        <div class="dash-row-bar"><div class="dash-row-fill" style="width:${pct}%"></div></div>
        <div class="dash-row-num">${moduleReviewed} 张</div>
      `;
      detail.appendChild(row);
    });
  }

  function moduleLabel(m: string) {
    return { vocabulary: '词汇', reading: '阅读', listening: '听力', grammar: '语法', writing: '写作' }[m] || m;
  }

  updateDashboard();
  window.addEventListener('cet4-progress-update', updateDashboard);
</script>
